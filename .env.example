# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: Supabase Service Role (for server-side operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel password — the login factor for the admin panel
ADMIN_PASSWORD=your-admin-password

# HMAC key that signs admin session cookies. Generate with: openssl rand -hex 32
# Rotating this invalidates every existing admin session.
ADMIN_SESSION_SECRET=your-admin-session-secret
